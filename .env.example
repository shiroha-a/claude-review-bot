# GitHub App
GITHUB_APP_ID=123456
# PEM private key. Newlines may be written as \n on a single line.
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=change-me

# Claude API
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=32000

# Review behavior
PORT=8787
REVIEW_LANGUAGE=Japanese
# Total patch characters sent to Claude per review
MAX_DIFF_CHARS=200000
# Comma-separated globs added to the built-in exclusions (lockfiles, dist, vendor, ...)
EXCLUDE_GLOBS=
# Author associations treated as maintainers: they can /review any PR and force a re-review.
# The PR author can always /review their own PR once per commit.
MAINTAINER_ASSOCIATIONS=OWNER,MEMBER,COLLABORATOR
# Review automatically on PR open/push (maintainer PRs only). Default: only on /review
AUTO_REVIEW=false
REVIEW_COMMAND=/review
